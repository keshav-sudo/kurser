# Redis Configuration (BullMQ Queue) - Auto-configured in Docker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kurser_redis_pass_2024

# Worker Configuration
WORKER_CONCURRENCY=5

# MongoDB Atlas (Same as main service)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kurser?retryWrites=true&w=majority

# Repository Clone Directory
CLONE_DIR=/tmp/kurser-repos

# GitHub Token (for private repos - optional)
GITHUB_TOKEN=

# Main API URL (Docker internal)
MAIN_API_URL=http://main:3000

# Logging
LOG_LEVEL=info
